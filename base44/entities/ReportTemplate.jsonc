{
  "name": "ReportTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Incident",
        "Arrest",
        "Traffic Stop",
        "Field Contact",
        "Use of Force",
        "Vehicle Accident",
        "Evidence",
        "Other"
      ]
    },
    "description": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "field_type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "date",
              "number"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "department_id": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category"
  ]
}