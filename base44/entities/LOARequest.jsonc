{
  "name": "LOARequest",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string"
    },
    "member_name": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Denied"
      ],
      "default": "Pending"
    },
    "reviewed_by": {
      "type": "string"
    }
  },
  "required": [
    "member_id",
    "department_id",
    "start_date",
    "end_date"
  ]
}