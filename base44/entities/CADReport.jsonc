{
  "name": "CADReport",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "Incident",
        "Arrest",
        "General Citation",
        "Vehicle Citation",
        "Use of Force",
        "MVA Report",
        "Fire",
        "Medical",
        "Use of Medications",
        "Traffic Stop",
        "Field Contact",
        "Evidence",
        "Other"
      ]
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "related_call_id": {
      "type": "string"
    },
    "filed_by_name": {
      "type": "string"
    },
    "filed_by_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Filed",
        "Reviewed",
        "Approved"
      ],
      "default": "Filed"
    },
    "run_number": {
      "type": "string"
    },
    "template_id": {
      "type": "string"
    },
    "field_data": {
      "type": "object",
      "additionalProperties": true
    },
    "linked_civilian_id": {
      "type": "string"
    },
    "linked_civilian_name": {
      "type": "string"
    },
    "linked_vehicle_plate": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "report_type",
    "description"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.filed_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.filed_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}