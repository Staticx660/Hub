{
  "name": "CADDepartment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Police",
        "Fire",
        "EMS",
        "Dispatch",
        "Civilian",
        "Private Security",
        "Other"
      ]
    },
    "description": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "default": "#3b82f6"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "category"
  ]
}