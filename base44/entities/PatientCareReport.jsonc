{
  "name": "PatientCareReport",
  "type": "object",
  "properties": {
    "department_id": {
      "type": "string"
    },
    "pcr_number": {
      "type": "string"
    },
    "patient_civilian_id": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "patient_dob": {
      "type": "string",
      "format": "date"
    },
    "patient_age": {
      "type": "string"
    },
    "patient_gender": {
      "type": "string",
      "enum": [
        "Male",
        "Female",
        "Other",
        "Unknown"
      ],
      "default": "Unknown"
    },
    "patient_race": {
      "type": "string"
    },
    "patient_address": {
      "type": "string"
    },
    "patient_phone": {
      "type": "string"
    },
    "blood_type": {
      "type": "string"
    },
    "incident_location": {
      "type": "string"
    },
    "pickup_location": {
      "type": "string"
    },
    "incident_type": {
      "type": "string"
    },
    "allergies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "food_allergies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "medications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "medical_history": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "symptoms": {
      "type": "string"
    },
    "last_oral_intake": {
      "type": "string"
    },
    "events_leading": {
      "type": "string"
    },
    "pain_onset": {
      "type": "string"
    },
    "pain_provocation": {
      "type": "string"
    },
    "pain_quality": {
      "type": "string"
    },
    "pain_radiation": {
      "type": "string"
    },
    "pain_severity": {
      "type": "string"
    },
    "pain_time": {
      "type": "string"
    },
    "general_impression": {
      "type": "string"
    },
    "loc": {
      "type": "string",
      "enum": [
        "Alert",
        "Verbal",
        "Pain",
        "Unresponsive"
      ],
      "default": "Alert"
    },
    "gcs_eye": {
      "type": "string"
    },
    "gcs_verbal": {
      "type": "string"
    },
    "gcs_motor": {
      "type": "string"
    },
    "pupils_left": {
      "type": "string"
    },
    "pupils_right": {
      "type": "string"
    },
    "skin_color": {
      "type": "string"
    },
    "skin_temp": {
      "type": "string"
    },
    "skin_condition": {
      "type": "string"
    },
    "airway_patency": {
      "type": "string",
      "enum": [
        "Open",
        "Partially Obstructed",
        "Obstructed"
      ],
      "default": "Open"
    },
    "airway_intervention": {
      "type": "string"
    },
    "breathing_effort": {
      "type": "string",
      "enum": [
        "Normal",
        "Labored",
        "Shallow",
        "Absent",
        "Agonal"
      ],
      "default": "Normal"
    },
    "breath_sounds_left": {
      "type": "string"
    },
    "breath_sounds_right": {
      "type": "string"
    },
    "circulation_pulse_location": {
      "type": "string"
    },
    "circulation_pulse_quality": {
      "type": "string"
    },
    "capillary_refill": {
      "type": "string"
    },
    "bleeding_control": {
      "type": "string"
    },
    "traumatic": {
      "type": "boolean",
      "default": false
    },
    "trauma_findings": {
      "type": "string"
    },
    "head_assessment": {
      "type": "string"
    },
    "neck_assessment": {
      "type": "string"
    },
    "chest_assessment": {
      "type": "string"
    },
    "abdomen_assessment": {
      "type": "string"
    },
    "pelvis_assessment": {
      "type": "string"
    },
    "back_assessment": {
      "type": "string"
    },
    "extremities_assessment": {
      "type": "string"
    },
    "vitals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "bp_systolic": {
            "type": "string"
          },
          "bp_diastolic": {
            "type": "string"
          },
          "heart_rate": {
            "type": "string"
          },
          "respiratory_rate": {
            "type": "string"
          },
          "spo2": {
            "type": "string"
          },
          "temperature": {
            "type": "string"
          },
          "bgl": {
            "type": "string"
          },
          "pain_score": {
            "type": "string"
          },
          "capillary_refill": {
            "type": "string"
          },
          "lung_sounds": {
            "type": "string"
          }
        }
      }
    },
    "iv_access": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "site": {
            "type": "string"
          },
          "gauge": {
            "type": "string"
          },
          "fluid": {
            "type": "string"
          },
          "flow_rate": {
            "type": "string"
          }
        }
      }
    },
    "treatments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "intervention": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        }
      }
    },
    "medications_administered": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "medication": {
            "type": "string"
          },
          "dose": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "response": {
            "type": "string"
          }
        }
      }
    },
    "narrative": {
      "type": "string"
    },
    "disposition": {
      "type": "string",
      "enum": [
        "Transported",
        "Treated/Released",
        "Refused AMA",
        "Deceased",
        "Transferred",
        "No Treatment"
      ],
      "default": "Transported"
    },
    "destination": {
      "type": "string"
    },
    "transport_method": {
      "type": "string"
    },
    "filed_by_name": {
      "type": "string"
    },
    "filed_by_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Filed",
        "Reviewed"
      ],
      "default": "Filed"
    },
    "linked_call_id": {
      "type": "string"
    }
  },
  "required": [
    "patient_name",
    "department_id"
  ]
}