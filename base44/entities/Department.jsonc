{
  "name": "Department",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Police & Sheriff",
        "Fire & EMS",
        "Hospitals & Medical",
        "Government & State",
        "Private Security",
        "Motorcycle Clubs",
        "Civilians",
        "Communications",
        "Other"
      ]
    },
    "description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "accent_color": {
      "type": "string"
    },
    "max_slots": {
      "type": "number"
    },
    "discord_webhook_url": {
      "type": "string"
    },
    "discord_server_id": {
      "type": "string"
    },
    "discord_role_id": {
      "type": "string"
    },
    "discord_supervisor_role_id": {
      "type": "string"
    },
    "loa_discord_role_id": {
      "type": "string"
    },
    "shift_quota_weekly": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "custom_url_slug": {
      "type": "string"
    },
    "ranks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "level": {
            "type": "number"
          },
          "insignia_url": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}