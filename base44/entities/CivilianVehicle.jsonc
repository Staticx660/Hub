{
  "name": "CivilianVehicle",
  "type": "object",
  "properties": {
    "plate": {
      "type": "string"
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "year": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "registration_status": {
      "type": "string",
      "enum": [
        "Valid",
        "Expired",
        "Suspended",
        "None"
      ],
      "default": "Valid"
    },
    "insurance_status": {
      "type": "string",
      "enum": [
        "Valid",
        "Expired",
        "None"
      ],
      "default": "Valid"
    },
    "is_stolen": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "plate"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}