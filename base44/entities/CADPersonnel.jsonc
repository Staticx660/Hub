{
  "name": "CADPersonnel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "discord_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "additional_department_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rank": {
      "type": "string"
    },
    "badge_number": {
      "type": "string"
    },
    "callsign": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Available",
        "On Duty",
        "Off Duty"
      ],
      "default": "Off Duty"
    },
    "assigned_unit_id": {
      "type": "string"
    },
    "is_supervisor": {
      "type": "boolean",
      "default": false
    },
    "is_cad_admin": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "department_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}