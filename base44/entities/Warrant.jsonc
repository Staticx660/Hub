{
  "name": "Warrant",
  "type": "object",
  "properties": {
    "person_name": {
      "type": "string"
    },
    "person_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "charges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issued_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Served",
        "Expired",
        "Cleared"
      ],
      "default": "Active"
    },
    "department_id": {
      "type": "string"
    },
    "issued_by_name": {
      "type": "string"
    },
    "issued_by_id": {
      "type": "string"
    },
    "bail_amount": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "person_name",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}