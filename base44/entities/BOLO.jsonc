{
  "name": "BOLO",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "bolo_type": {
      "type": "string",
      "enum": [
        "Person",
        "Vehicle",
        "Firearm",
        "Other"
      ]
    },
    "person_name": {
      "type": "string"
    },
    "vehicle_plate": {
      "type": "string"
    },
    "vehicle_description": {
      "type": "string"
    },
    "last_seen_location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Resolved"
      ],
      "default": "Active"
    },
    "department_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ],
      "default": "Medium"
    }
  },
  "required": [
    "title",
    "description"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dispatcher"
          }
        },
        {
          "user_condition": {
            "role": "officer"
          }
        },
        {
          "user_condition": {
            "role": "ems"
          }
        },
        {
          "user_condition": {
            "role": "fire"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}