{
  "name": "CADUnitGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "unit_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "min_seats": {
      "type": "number",
      "default": 1
    },
    "max_seats": {
      "type": "number",
      "default": 4
    },
    "status": {
      "type": "string",
      "enum": [
        "Available",
        "Busy",
        "On Call",
        "Unavailable",
        "Off Duty"
      ],
      "default": "Off Duty"
    }
  },
  "required": [
    "name",
    "department_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}