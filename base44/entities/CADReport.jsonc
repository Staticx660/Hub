{
  "name": "CADReport",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "Incident",
        "Traffic Stop",
        "Field Contact",
        "Arrest",
        "Medical",
        "Fire",
        "Vehicle Accident",
        "Use of Force",
        "Evidence",
        "Other"
      ]
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "related_call_id": {
      "type": "string"
    },
    "filed_by_name": {
      "type": "string"
    },
    "filed_by_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Filed",
        "Reviewed",
        "Approved"
      ],
      "default": "Filed"
    },
    "run_number": {
      "type": "string"
    },
    "template_id": {
      "type": "string"
    },
    "field_data": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "title",
    "report_type",
    "description"
  ]
}