{
  "name": "CADDepartment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Police",
        "Fire",
        "EMS",
        "Dispatch",
        "Civilian",
        "Private Security",
        "Other"
      ]
    },
    "description": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "default": "#3b82f6"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "discord_webhook_url": {
      "type": "string"
    },
    "discord_server_id": {
      "type": "string"
    },
    "discord_role_id": {
      "type": "string"
    },
    "discord_supervisor_role_id": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}