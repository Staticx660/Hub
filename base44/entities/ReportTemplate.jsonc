{
  "name": "ReportTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Incident",
        "Arrest",
        "Traffic Stop",
        "Field Contact",
        "Use of Force",
        "Vehicle Accident",
        "Evidence",
        "Medical",
        "Fire",
        "Other"
      ]
    },
    "description": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "field_type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "address",
              "select",
              "checkboxes",
              "date",
              "time",
              "image",
              "status",
              "label",
              "id",
              "random",
              "number",
              "UNIT_NUMBER",
              "UNIT_NAME",
              "UNIT_RANK",
              "UNIT_AGENCY",
              "UNIT_DEPARTMENT",
              "UNIT_SUBDIVISION",
              "UNIT_AGENCY_LOCATION",
              "UNIT_AGENCY_ZIP",
              "UNIT_LOCATION"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "department_id": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}