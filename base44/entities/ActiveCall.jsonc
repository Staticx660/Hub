{
  "name": "ActiveCall",
  "type": "object",
  "properties": {
    "call_type": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "1 - High",
        "2 - Medium",
        "3 - Low"
      ],
      "default": "3 - Low"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Active",
        "Closed"
      ],
      "default": "Pending"
    },
    "location": {
      "type": "string"
    },
    "cross_streets": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "caller_name": {
      "type": "string"
    },
    "caller_phone": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "assigned_unit_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "run_number": {
      "type": "string"
    },
    "cad_notes": {
      "type": "string"
    },
    "call_origin": {
      "type": "string"
    },
    "postal": {
      "type": "string"
    },
    "block": {
      "type": "string"
    },
    "assignment_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit_name": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "call_type",
    "location"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}