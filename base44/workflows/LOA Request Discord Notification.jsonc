{
  "name": "LOA Request Discord Notification",
  "description": "When a new LOARequest is created, sends a Discord webhook notification to the associated department's channel.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "LOARequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "loa_request_discord_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyNewLOA",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyNewLOA"
  }
}