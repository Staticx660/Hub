{
  "name": "Document",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "SOP",
        "Policy",
        "Training",
        "Guide",
        "Form",
        "Other"
      ]
    },
    "content": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "department_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}