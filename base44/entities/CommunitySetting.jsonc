{
  "name": "CommunitySetting",
  "type": "object",
  "properties": {
    "community_name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "accent_color": {
      "type": "string",
      "default": "#3b82f6"
    },
    "discord_invite_url": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "civilian_limit_per_user": {
      "type": "number",
      "default": 5
    },
    "notification_tones": {
      "type": "object",
      "additionalProperties": true
    },
    "is_setup": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "community_name"
  ]
}